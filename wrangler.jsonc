{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campuspass",
  "main": "src/index.ts",
  // Public host: pass.tecxmate.com (Workers Custom Domain; Cloudflare creates the DNS record and certificate).
  // workers_dev stays on so https://campuspass.niko-tecx.workers.dev keeps working.
  "routes": [{ "pattern": "pass.tecxmate.com", "custom_domain": true }],
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campuspass",
      "database_id": "e2fd1b29-9117-44ef-9995-ac74f03e15b9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": ""
  },
  // Per-IP limits read by src/index.ts (absent binding = unlimited). namespace_id is account-wide:
  // distinctive ids so other Workers on the account (bizmap etc.) never share these counters.
  "ratelimits": [
    { "name": "RL_FORMS", "namespace_id": "20261001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CONFIRM", "namespace_id": "20261002", "simple": { "limit": 30, "period": 60 } }
  ],
  // Daily cleanup at 03:17 Asia/Taipei (19:17 UTC): expired sessions, data past retention
  "triggers": { "crons": ["17 19 * * *"] },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put <NAME>`, or .dev.vars locally):
  //   GOOGLE_CLIENT_SECRET, ADMIN_TOKEN
}
