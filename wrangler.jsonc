{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campuspass",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campuspass",
      // Replace with the id printed by `npx wrangler d1 create campuspass`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": ""
  },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put <NAME>`, or .dev.vars locally):
  //   GOOGLE_CLIENT_SECRET, ADMIN_TOKEN
}
