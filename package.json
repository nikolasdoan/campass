{
  "name": "campuspass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply campuspass --local",
    "db:migrate:remote": "wrangler d1 migrations apply campuspass --remote",
    "db:seed:local": "wrangler d1 execute campuspass --local --file seed/deals.sql",
    "db:seed:remote": "wrangler d1 execute campuspass --remote --file seed/deals.sql",
    "import": "python3 scripts/import_deals.py data/ntu-partners.xlsx",
    "test:ui": "node tests/ui.mjs",
    "test:api": "node tests/api.mjs",
    "mock-google": "node tests/mock-google.mjs",
    "test": "node tests/api.mjs && node tests/ui.mjs && node tests/pwa.mjs && node tests/admin.mjs",
    "test:pwa": "node tests/pwa.mjs",
    "test:admin": "node tests/admin.mjs"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  }
}
